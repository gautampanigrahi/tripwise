# Copy to .env.local and fill in from the Terraform outputs (scripts/deploy.sh writes it for you).
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Hosted UI domain without scheme, e.g. tripwise.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=tripwise.auth.us-east-1.amazoncognito.com
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
# Optional. Defaults to window.location.origin + "/".
# VITE_REDIRECT_URL=http://localhost:5173/
